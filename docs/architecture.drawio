<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Service Request System: Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="User&lt;br&gt;(Requester / Support staff)" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=right;align=left;verticalAlign=middle;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="415" y="60" width="30" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="frontend" value="Frontend (Next.js)&lt;br&gt;Request list, create form, details page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="170" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="backend" value="Backend API (Express.js + TypeScript)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="230" y="300" width="400" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="controllers" value="Routes / Controllers&lt;br&gt;HTTP, request and response, status codes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="backend">
          <mxGeometry x="60" y="50" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="services" value="Services (use cases)&lt;br&gt;Business rules, status flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="backend">
          <mxGeometry x="60" y="150" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="repos" value="Repositories (data access)&lt;br&gt;Queries and saving data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="backend">
          <mxGeometry x="60" y="250" width="280" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="database" value="Database (PostgreSQL)&lt;br&gt;requests table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="720" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="crosscutting" value="Cross-cutting concerns&lt;br&gt;Configuration, validation, logging, error handling, automated tests" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="email" value="External: Email service&lt;br&gt;(future, not in MVP)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="680" y="450" width="240" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="Dashed boxes = shared concerns or future items" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="680" y="520" width="260" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="uses browser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="HTTPS + JSON (REST /api)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="frontend" target="controllers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="validated input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="controllers" target="services">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="data operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="services" target="repos">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="SQL queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repos" target="database">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="future (F-03)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="services" target="email">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
